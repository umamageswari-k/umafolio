}
.icon{
width:50px;
height:50px;
margin:10px;
cursor:pointer;
border-radius:20px;
}
.icon:hover{
transform: scale(1.2);
transition: 0.3s;
}
button{
margin-top:30px;
padding:10px 20px;
border-radius:20px;
cursor:pointer;
}


footer{
margin-top:40px;
font-size:14px;
}
</style>
